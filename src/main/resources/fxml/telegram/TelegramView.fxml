<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gymapp.ui.telegram.TelegramController"
      spacing="16"
      styleClass="page-root">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox spacing="5">
        <Label text="Telegram"
               styleClass="page-title"/>

        <Label text="Розсилка повідомлень клієнтам спортзалу"
               styleClass="muted-text"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Підключено клієнтів:"
               styleClass="form-label"/>

        <Label fx:id="connectedClientsLabel"
               text="0"
               styleClass="status-pill,status-pill-success"/>
    </HBox>

    <VBox spacing="8">

        <Label text="Одержувачі"
               styleClass="form-label"/>

        <fx:define>
            <ToggleGroup fx:id="recipientToggleGroup"/>
        </fx:define>

        <HBox spacing="20">
            <RadioButton fx:id="allRecipientsRadio"
                         text="Усі підключені"
                         selected="true"
                         toggleGroup="$recipientToggleGroup"
                         onAction="#onRecipientModeChanged"/>

            <RadioButton fx:id="selectedRecipientsRadio"
                         text="Вибрати клієнтів"
                         toggleGroup="$recipientToggleGroup"
                         onAction="#onRecipientModeChanged"/>
        </HBox>

        <TextField fx:id="searchField"
                   promptText="Пошук за ім'ям або номером клієнта..."
                   disable="true"/>

        <ListView fx:id="recipientsListView"
                  prefHeight="180"
                  disable="true"/>

        <Label fx:id="selectedCountLabel"
               text="Вибрано: 0"
               styleClass="muted-text"
               visible="false"
               managed="false"/>

    </VBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">

        <Label text="Повідомлення"
               styleClass="form-label"/>

        <TextArea fx:id="messageTextArea"
                  promptText="Введіть текст повідомлення..."
                  wrapText="true"
                  prefRowCount="7"
                  VBox.vgrow="ALWAYS"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">

        <Label fx:id="charactersLabel"
               text="0 символів"
               styleClass="muted-text"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="sendButton"
                text="Надіслати"
                onAction="#onSend"
                styleClass="button,primary-button"/>

    </HBox>

</VBox>