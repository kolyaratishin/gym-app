<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gymapp.ui.database.DatabaseController"
            fitToWidth="true"
            styleClass="page-root">

    <content>
        <VBox spacing="24" styleClass="page-root">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="База даних" styleClass="page-title"/>

            <VBox spacing="12" styleClass="section-card">
                <Label text="Резервна копія" styleClass="section-title"/>
                <Label text="Створити копію бази даних у стандартній папці. Якщо задано додатковий шлях — копія також буде збережена туди."
                       styleClass="muted-text"
                       wrapText="true"/>

                <Button text="Створити резервну копію"
                        onAction="#onCreateBackup"
                        styleClass="primary-button"/>

                <Label fx:id="backupStatusLabel" styleClass="muted-text" wrapText="true"/>
            </VBox>

            <VBox spacing="12" styleClass="section-card">
                <Label text="Додаткова копія" styleClass="section-title"/>
                <Label text="Шлях для збереження копії на флешку або інший диск:"
                       styleClass="muted-text"
                       wrapText="true"/>

                <HBox spacing="10">
                    <TextField fx:id="extraBackupPathField"
                               promptText="Наприклад: E:\GymBackups"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Вибрати папку"
                            onAction="#onChooseExtraBackupPath"/>
                </HBox>

                <HBox spacing="10">
                    <Button text="Зберегти шлях"
                            onAction="#onSaveExtraBackupPath"
                            styleClass="success-button"/>

                    <Button text="Очистити"
                            onAction="#onClearExtraBackupPath"/>
                </HBox>
            </VBox>

            <Separator/>

            <VBox spacing="12" styleClass="section-card">
                <Label text="Відновлення" styleClass="section-title"/>
                <Label text="Відновити базу даних з резервної копії."
                       styleClass="muted-text"
                       wrapText="true"/>

                <Button text="Відновити базу даних"
                        onAction="#onRestoreBackup"
                        styleClass="danger-button"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>